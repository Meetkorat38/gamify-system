# Optional public Expo/API configuration.
# Do not put private keys or database passwords in client-bundled variables.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=

# Server-only values, if backend features are enabled locally, belong in .env.local
# and must never be committed.

# Server-only AI coach (OpenRouter). Put OPENROUTER_API_KEY in .env.local locally,
# or in the platform secret store in Manus — never commit it, never use EXPO_PUBLIC_.
# OPENROUTER_API_KEY=
# Optional model override; defaults to DeepSeek v4.1 Flash with automatic fallbacks:
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
